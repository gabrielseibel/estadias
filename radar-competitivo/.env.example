# ─────────────────────────────────────────────────────────────
# Radar Competitivo — configuração
# Copie para .env (na raiz do monorepo) e ajuste.
# ─────────────────────────────────────────────────────────────

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://radar:radar@localhost:5432/radar?schema=public"

# API
PORT=4000
NODE_ENV=development
# Segredo de assinatura de JWT. OBRIGATÓRIO em produção (mín. 32 caracteres).
JWT_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="12h"
# Origens permitidas no CORS (separadas por vírgula).
# Aceita a origem completa ("https://app.exemplo.com") ou só o hostname
# ("app.exemplo.com") — plataformas de deploy costumam expor apenas o host.
CORS_ORIGINS="http://localhost:5173"

# Endereço da API usado no BUILD da interface. Só é necessário quando a
# interface e a API ficam em origens diferentes (site estático + serviço web).
# Em desenvolvimento e no Docker Compose a origem é a mesma e o padrão resolve.
# VITE_API_URL="https://sua-api.onrender.com/api"

# ── Crawler ──────────────────────────────────────────────────
CRAWLER_USER_AGENT="RadarCompetitivoBot/0.1 (+https://radarcompetitivo.example/bot)"
# Páginas máximas coletadas por site em uma execução
CRAWLER_MAX_PAGES_PER_SITE=25
# Profundidade máxima a partir da home
CRAWLER_MAX_DEPTH=2
# Intervalo mínimo entre requisições ao mesmo domínio (ms)
CRAWLER_DOMAIN_DELAY_MS=1500
# Timeout por requisição (ms)
CRAWLER_TIMEOUT_MS=15000
# Tamanho máximo de resposta aceito (bytes)
CRAWLER_MAX_BYTES=3000000
# Número de tentativas em falhas transitórias
CRAWLER_MAX_RETRIES=2
# Concorrência global de páginas
CRAWLER_CONCURRENCY=4
# Respeitar robots.txt. Manter "true". Alterar apenas em ambientes de teste próprios.
CRAWLER_RESPECT_ROBOTS=true
# PERIGO: permite alvos em redes privadas/localhost. Somente para testes locais.
CRAWLER_ALLOW_PRIVATE_HOSTS=false
# Quantos jobs simultâneos por organização
JOBS_MAX_CONCURRENT_PER_ORG=2
# Ativa o worker no mesmo processo da API (dev). Em produção use `npm run worker`.
WORKER_INLINE=true
WORKER_POLL_MS=1500

# ── Descoberta de concorrentes (busca web) ───────────────────
# Provedor de busca: "none" | "searxng" | "brave" | "google_cse"
# Sem provedor configurado o sistema informa "Fonte ainda não disponível"
# e o cadastro de concorrentes é feito manualmente (por domínio).
SEARCH_PROVIDER=none
SEARXNG_URL=""
BRAVE_SEARCH_API_KEY=""
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""

# ── IA (opcional) ────────────────────────────────────────────
# Sem chave, a plataforma continua funcionando: o motor analítico
# determinístico gera scores, gaps, oportunidades, ameaças e recomendações.
# A IA acrescenta síntese narrativa e o chat "Ask Radar".
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_MAX_TOKENS=4000

# ── Retenção de dados (LGPD) ─────────────────────────────────
# Dias de retenção do HTML bruto coletado (evidência textual é mantida).
RAW_CONTENT_RETENTION_DAYS=30
